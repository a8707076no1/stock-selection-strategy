# ─────────────────────────────────────────────
# 台股飆股系統 環境變數範本
# ─────────────────────────────────────────────
# 使用方式：
#   1. 複製本檔案為 .env（.env 已 gitignore 不會上傳）
#   2. 填入實際值
#   3. Local：source .env 或用 direnv 自動載入
#   4. GitHub Actions：把每個變數存進 Repo Settings → Secrets
#
# ─────────────────────────────────────────────

# Telegram bot
STOCK_TG_TOKEN=          # bot token（BotFather 給的）
STOCK_TG_CHAT=           # 主要接收 chat_id
STOCK_TG_CHAT_EXTRA=     # 額外接收 chat_id（多人以逗號分隔）

# Cloudflare（Pages/R2 部署用）
CLOUDFLARE_ACCOUNT_ID=938422b6f5c59cd973aa449dca60f706
CLOUDFLARE_API_TOKEN=

# 系統路徑
STOCK_BASE_DIR=/Users/a8707076/Desktop/Stock Selection Strategy
